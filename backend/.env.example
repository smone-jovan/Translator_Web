# LLM Provider API Keys
# Copy this file to backend/.env and fill in your keys
# This file is gitignored - never commit your actual keys

# OpenAI API Key (optional, for GPT models)
OPENAI_API_KEY=

# Google Gemini API Key (optional, free tier at https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenRouter API Key (optional, access multiple cloud models at https://openrouter.ai/)
OPENROUTER_API_KEY=
